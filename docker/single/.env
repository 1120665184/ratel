# =============================================
# GWSU 单机版 Docker 环境变量配置
# =============================================

# nginx 对外端口
NGINX_PORT=80

# PostgreSQL 配置
DB_NAME=gwsu
DB_USERNAME=root
DB_PASSWORD=root

# Redis 配置
REDIS_PASSWORD=redis

# 钉钉快捷登录：钉钉配置
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 代理配置（宿主机代理，host.docker.internal 指向宿主机 IP）
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis
