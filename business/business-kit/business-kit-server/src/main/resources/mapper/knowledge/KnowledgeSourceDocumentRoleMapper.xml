<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.quyq.gwsu.kit.knowledge.mapper.KnowledgeSourceDocumentRoleMapper">

    <select id="selectBySourceDocumentIds" resultType="org.quyq.gwsu.kit.knowledge.domain.KitKnowledgeSourceDocumentRole">
        SELECT *
        FROM kit_knowledge_source_document_role
        WHERE deleted = 0
          <choose>
              <when test="sourceDocumentIds != null and sourceDocumentIds.size() > 0">
                  AND source_document_id IN
                  <foreach collection="sourceDocumentIds" item="sourceDocumentId" open="(" separator="," close=")">
                      #{sourceDocumentId}
                  </foreach>
              </when>
              <otherwise>
                  AND 1 = 0
              </otherwise>
          </choose>
    </select>
</mapper>
