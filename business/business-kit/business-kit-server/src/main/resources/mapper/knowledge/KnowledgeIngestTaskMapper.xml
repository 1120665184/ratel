<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.quyq.gwsu.kit.knowledge.mapper.KnowledgeIngestTaskMapper">
    <select id="selectIdsBySourceDocumentId" resultType="java.lang.String">
        SELECT id
        FROM kit_knowledge_ingest_task
        WHERE deleted = 0
          AND source_document_id = #{sourceDocumentId}
    </select>
</mapper>
